import { createLogger } from '@temp-repo/logger'
import { app } from '@temp-repo/{{ name }}-api'
import { {{ camelCase name }}EnvConfig } from '@temp-repo/{{ name }}-config'

const logger = createLogger('{{ name }}')

// The full app (HTTP routes + the WebSocket room) lives in @temp-repo/{{ name }}-api;
// the entry just starts the Bun server.
const port = {{ camelCase name }}EnvConfig.app.port
app.listen(port)
const url = process.env.PORTLESS_URL ?? `http://localhost:${port}`
logger.info(`🚀 {{ name }} server listening on ${url}`)
