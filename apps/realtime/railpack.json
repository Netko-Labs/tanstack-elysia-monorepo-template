{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "deployOutputs": [],
      "commands": ["...", "bun run repo build --app realtime"]
    }
  },
  "deploy": {
    "paths": ["/mise/installs/bun/latest/bin"],
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/installs/bun"]
      },
      {
        "step": "build",
        "include": ["apps/realtime/dist"]
      }
    ],
    "startCommand": "bun run apps/realtime/dist/index.js"
  }
}
